# Copy this file to ".env" and fill in your key. Never commit .env to Git!

# Which AI provider to use: dial | openai | gemini
LLM_PROVIDER=gemini
API_KEY=put-your-key-here

# Only for DIAL (EPAM AI proxy), used when LLM_PROVIDER=dial
DIAL_ENDPOINT=https://ai-proxy.lab.epam.com
DIAL_API_VERSION=2024-02-01

# Optional: override default models (leave empty to use the defaults for the provider)
CHAT_MODEL=
EMBEDDING_MODEL=
# Optional: shorter vectors for text-embedding-3-* models (e.g. 512). Empty = model default.
EMBEDDING_DIMENSIONS=

# Vector database
QDRANT_URL=http://localhost:6333
COLLECTION_NAME=qazaq_guide

TOP_K=4
TEMPERATURE=0.3
